# Docker Compose ports (host -> container)
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Frontend API base URL (baked into Next.js client bundle at build time)
# For local Docker Compose usage, localhost is correct because the browser runs on your host.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Demo API key sent by the frontend (baked into the client bundle - see
# frontend/src/services/api.ts's comment on why this isn't production-grade).
# Must match one of the keys in RETAILOS_API_KEYS below (or the built-in
# demo defaults in src/api/auth.py if RETAILOS_API_KEYS is unset).
NEXT_PUBLIC_API_KEY=demo-analyst-key

# Backend role-based API keys, format 'key1:role1,key2:role2'.
# Roles: analyst < store_manager < finance < admin. Leave unset to use the
# built-in demo keys in src/api/auth.py (demo-analyst-key, etc.) - do not
# rely on those defaults outside local development.
RETAILOS_API_KEYS=

# Uvicorn
UVICORN_WORKERS=1

# WebSocket (only used if you run the streaming server separately)
WS_HOST=localhost
WS_PORT=8765

# Named volume for DuckDB persistence
DUCKDB_VOLUME_NAME=retailos_duckdb
